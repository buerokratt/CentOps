{
"items": [
{{#each entries}}
    {
    "clientId": "{{clientId}}",
    "name": "{{name}}",
    "authenticationCertificate": "{{escapeCertificate authenticationCertificate}}",
    "createdAt": "{{createdAt}}",
    "updatedAt": {{#if updatedAt}}"{{updatedAt}}"{{else}}null{{/if}}
    }{{#unless @last}},{{/unless}}
{{/each}}
],
"page": {{page}},
"pageSize": {{pageSize}},
"totalPages": {{#if entries.[0]}}{{entries.[0].totalPages}}{{else}}0{{/if}}
}